---
import Hero from '../components/Hero.astro';
import Title from '../components/Title.astro';
import Layout from '../layouts/Layout.astro';
import { getEntryBySlug } from 'astro:content';
import ItemAnnouncement from '../components/ItemAnnouncement.astro';

const announcementEntry = await getEntryBySlug('announcements', 'team');
const images = announcementEntry?.data.images ?? [];
---

<Layout title="IMPETUS INDOMITUS" description="A research team">
  <Hero />

  <!-- MISSION / VISION / DIRECTOR -->
  <section class="max-w-screen-xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
    <!-- Text Section -->
    <div class="space-y-6">
      <div>
        <h5 class="text-xl font-semibold mb-2">Our Mission</h5>
        <p class="text-base md:text-lg text-gray-800">
          Serve our community solving problems within our research topics with revolutionary approaches, when needed, in the energy conversion, propulsion, and transportation areas.
        </p>
      </div>
      <div>
        <h5 class="text-xl font-semibold mb-2">Our Vision</h5>
        <p class="text-base md:text-lg text-gray-800">
          Become a Research School with theoretical and technological development in the energy conversion, propulsion, and transportation areas to serve our community.
        </p>
      </div>
      <div>
        <h5 class="text-xl font-semibold mb-2">Our Values</h5>
        <ul class="text-base md:text-lg text-gray-800 space-y-1">
          <li>1. We exist to serve.</li>
          <li>2. We research and solve problems to serve our community.</li>
          <li>3. We work as a team showing respect and being humble.</li>
        </ul>
      </div>
      <div>
        <h5 class="text-xl font-semibold mb-2">Goals</h5>
        <ul class="text-base md:text-lg text-gray-800 space-y-2">
          <li>1. Serve the community solving problems, based on our principles, through fundamental and applied research in each one of the research topics of our team Impetus Indomitus.</li>
          <li>2. Encourage teamwork in our members following the research team principles.</li>
        </ul>
      </div>
    </div>

    <!-- Director Card -->
    <div class="px-4 sm:px-6 md:px-8">
      <div class="bg-black text-white rounded-lg px-6 py-6 flex flex-col items-center text-center w-full">
        <h4 class="text-lg font-semibold">Director</h4>
        <img src="/images/home/guillermo.webp" alt="Director Guillermo Andrés Jaramillo Pizarro" class="my-6 w-40 h-40 rounded-lg object-cover hover:scale-105 transition-transform duration-200" />
        <div class="text-sm space-y-2 break-words max-w-full overflow-wrap">
          <p>
            Universidad del Valle - College of Engineering - School of Mechanical Engineering<br />
            Associate Professor - Fluid mechanics lab coordinator - ASME - UNIVERSIDAD DEL VALLE Student Section Advisor
          </p>
          <p>
            Calle 13#100-00, Campus Meléndez, building E33 - room 1009 - Cali, Colombia.<br />
            Tel: +(57) 602-321-2100 Ext: 3765
          </p>
          <p>
            Email: <a href="mailto:guillermo.jaramillo@correounivalle.edu.co" class="underline hover:text-blue-300">guillermo.jaramillo@correounivalle.edu.co</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="w-full bg-black border-b border-white h-1"></div>

  <!-- Call to Action -->
  <section class="max-w-screen-xl mx-auto px-4 py-20 text-center">
    <h2 class="text-3xl font-bold mb-4">Join Our Research Team</h2>
    <p class="text-lg text-gray-800 mb-8">
      Be part of a community dedicated to knowledge and discovery. Collaborate, innovate, and contribute to impactful research.
    </p>
    <a href="/admissions" class="bg-black text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">Join Now</a>
  </section>

  <!-- Topics -->
  <section class="px-4">
    <Title title="Research Topics" />
    <div class="max-w-screen-xl mx-auto py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white p-6 rounded-lg shadow hover:shadow-xl transition-transform hover:scale-105">
        <h3 class="text-xl font-semibold mb-2 text-center">Thermofluid Mechanics, Electromagnetism and Optics</h3>
        <img src="https://placehold.co/300x200" alt="Thermofluid Mechanics" class="w-full h-auto rounded-lg mt-4" />
      </div>
      <div class="bg-white p-6 rounded-lg shadow hover:shadow-xl transition-transform hover:scale-105">
        <h3 class="text-xl font-semibold mb-2 text-center">Propulsion and Energy Conversion Systems</h3>
        <img src="/images/home/topics/PROPULSION-AND-ENERGY-CONVERSION-SYSTEMS-_1_.webp" alt="Propulsion and Energy" class="w-full h-auto rounded-lg mt-4" />
      </div>
      <div class="bg-white p-6 rounded-lg shadow hover:shadow-xl transition-transform hover:scale-105">
        <h3 class="text-xl font-semibold mb-2 text-center">Hidronautics, Aeronautics and Astronautics</h3>
        <img src="/images/home/topics/Hidronautics_-Aeronautics-and-Astronautics-_1_.webp" alt="Hidronautics" class="w-full h-auto rounded-lg mt-4" />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="w-full bg-black border-b border-white h-1"></div>

  <!-- Explore Section -->
  <section class="max-w-screen-xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div class="flex justify-center gap-6 flex-wrap md:flex-nowrap">
      <img
        src="/images/home/IMG_0507.webp"
        alt="Image 1"
        class="rounded-lg shadow w-full max-w-[240px] h-auto object-cover hover:scale-105 transition-transform duration-200"
        loading="lazy"
      />
      <img
        src="/images/home/IMG_0503.webp"
        alt="Image 2"
        class="rounded-lg shadow w-full max-w-[240px] h-auto object-cover hover:scale-105 transition-transform duration-200"
        loading="lazy"
      />
    </div>
    <div class="w-full text-left md:text-right">
      <h2 class="text-3xl font-bold mb-4">Explore our Knowledge</h2>
      <p class="text-lg text-gray-800 mb-8">
        Access our collection of documents and publications. Discover the advancements and studies from our research team.
      </p>
      <a href="/search" class="bg-black text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">Explore</a>
    </div>
  </section>

  <!-- Announcements -->
  <ItemAnnouncement images={images} />
</Layout>
